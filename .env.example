# =============================================================================
# DriftForge Environment Configuration Template
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=data/driftforge.db
TIMEZONE=UTC

# LLM API Settings (MiniMax Anthropic-compatible or native Anthropic)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_API_KEY=your_minimax_or_anthropic_api_key_here
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT=60

# Security & Auth
ADMIN_API_KEY=driftforge-admin-secret

# Ingestion & Scheduling
SCHEDULER_ENABLED=true
INGESTION_SCHEDULE_MINUTES=5
# INGESTION_SCHEDULE_HOURS=1

# Feed & Article Limits
MAX_ARTICLES_PER_FEED=30
MAX_PROCESS_PER_RUN=50
GNEWS_MAX_PER_DOMAIN=10

# Scraping & Performance Tuning
FEED_TIMEOUT_SECONDS=4.0
SCRAPE_TIMEOUT_SECONDS=3.5
MAX_SCRAPE_WORKERS=10
MAX_ARTICLE_TEXT_CHARS=3500

# LLM Extraction Tuning
EXTRACTOR_BATCH_SIZE=5
EXTRACTOR_MAX_CONCURRENCY=2

# Graph Database
# USE_KUZU=true
# KUZU_DB_PATH=data/kuzu_store

# Optional AWS Settings (for S3 static mirror / Lambda deployment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=news-knowledge-graph
